new file mode 100644
index 00000000..062f0e58
--- /dev/null
+++ b/examples/server/auth.hpp
@@ -0,0 +1,96 @@
+#pragma once
+
+#include "httplib.h"
+
+#include <algorithm>
+#include <array>
+#include <cctype>
+#include <fstream>
+#include <string>
+
+namespace whisper_server_auth {
+
+inline bool is_loopback_bind_host(const std::string & host) {
+    return host == "127.0.0.1" || host == "::1" || host == "localhost";
+}
+
+inline bool load_api_key_file(const std::string & path, std::string & key) {
+    std::ifstream input(path, std::ios::binary);
+    if (!input) {
+        return false;
+    }
+
+    // Read at most the maximum token length plus one newline and one overflow
+    // byte. This keeps an attacker-controlled file from growing the key buffer.
+    std::array<char, 4098> buffer{};
+    input.read(buffer.data(), static_cast<std::streamsize>(buffer.size()));
+    const auto count = static_cast<size_t>(input.gcount());
+    if (input.bad() || count == buffer.size()) {
+        return false;
+    }
+
+    if (count > 0 && buffer[count - 1] == '\n') {
+        key.assign(buffer.data(), count - 1);
+    } else {
+        key.assign(buffer.data(), count);
+    }
+    if (key.empty() || key.size() > 4096) {
+        return false;
+    }
+    return std::none_of(key.begin(), key.end(), [](unsigned char ch) {
+        return std::isspace(ch) || std::iscntrl(ch);
+    });
+}
+
+inline bool constant_time_equal(const std::string & left, const std::string & right) {
+    const size_t count = std::max(left.size(), right.size());
+    size_t difference = left.size() ^ right.size();
+    for (size_t index = 0; index < count; ++index) {
+        const unsigned char a = index < left.size()
+            ? static_cast<unsigned char>(left[index]) : 0;
+        const unsigned char b = index < right.size()
+            ? static_cast<unsigned char>(right[index]) : 0;
+        difference |= static_cast<size_t>(a ^ b);
+    }
+    return difference == 0;
+}
+
+inline httplib::Server::HandlerWithResponse make_pre_routing_handler(
+    const std::string & api_key,
+    const std::string & request_path
+) {
+    const std::string health_path = request_path + "/health";
+    return [&api_key, health_path](
+        const httplib::Request & req,
+        httplib::Response & res
+    ) {
+        if (req.method == "GET" && req.path == health_path) {
+            return httplib::Server::HandlerResponse::Unhandled;
+        }
+        const std::string authorization = req.get_header_value("Authorization");
+        const std::string bearer_prefix = "Bearer ";
+        if (authorization.compare(0, bearer_prefix.size(), bearer_prefix) == 0
+            && constant_time_equal(
+                authorization.substr(bearer_prefix.size()), api_key)) {
+            return httplib::Server::HandlerResponse::Unhandled;
+        }
+        res.status = 401;
+        res.set_header("WWW-Authenticate", "Bearer");
+        res.set_content("{\"error\":\"unauthorized\"}", "application/json");
+        return httplib::Server::HandlerResponse::Handled;
+    };
+}
+
+inline void handle_server_error(
+    const httplib::Request & req,
+    httplib::Response & res
+) {
+    if (res.status == 400) {
+        res.set_content("Invalid request", "text/plain");
+    } else if (res.status != 401 && res.status != 500) {
+        res.set_content("File Not Found (" + req.path + ")", "text/plain");
+        res.status = 404;
+    }
+}
+
+}  // namespace whisper_server_auth
